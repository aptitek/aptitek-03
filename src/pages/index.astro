---
import Card from '@mui/material/Card';
import CardContent from '@mui/material/CardContent';
import Typography from '@mui/material/Typography';
import Chip from '@mui/material/Chip';
import Layout from '../layouts/Layout.astro';
import { HeroActions } from '../components/HeroActions';
import '../styles/features.css';
---

<Layout title="AptiTek — Modern Web Application Template">
  <main class="page">
    <header class="hero">
      <Chip
        label="Production Ready Template"
        variant="outlined"
        color="primary"
        className="hero-badge"
      />
      <h1 class="title">AptiTek Modern Web Stack</h1>
      <p class="subtitle">
        Architecture modulaire haute performance combinant Astro, React,
        Storybook, Vitest, Playwright et Wireit.
      </p>

      <HeroActions
        client:load
        docsLabel="Documentation Astro"
        sampleDocLabel="Exemple de Document A4"
      />
    </header>

    <section class="features">
      <Card variant="outlined" className="feature-card">
        <CardContent className="feature-card__content">
          <Typography
            variant="h6"
            component="h2"
            className="feature-card__title"
          >
            Architecture & Framework
          </Typography>
          <Typography variant="body2" className="feature-card__description">
            Astro en mode statique haute vitesse couplé à React pour
            l'interactivité dynamique ciblée.
          </Typography>
        </CardContent>
      </Card>

      <Card variant="outlined" className="feature-card">
        <CardContent className="feature-card__content">
          <Typography
            variant="h6"
            component="h2"
            className="feature-card__title"
          >
            Design System & Storybook
          </Typography>
          <Typography variant="body2" className="feature-card__description">
            Développement isolé et tests visuels et d'interactions avec
            Storybook et Vitest Browser.
          </Typography>
        </CardContent>
      </Card>

      <Card variant="outlined" className="feature-card">
        <CardContent className="feature-card__content">
          <Typography
            variant="h6"
            component="h2"
            className="feature-card__title"
          >
            Tests E2E & Couverture
          </Typography>
          <Typography variant="body2" className="feature-card__description">
            Playwright pour les parcours utilisateurs réels et Vitest V8 pour la
            couverture de code intégrée.
          </Typography>
        </CardContent>
      </Card>

      <Card variant="outlined" className="feature-card">
        <CardContent className="feature-card__content">
          <Typography
            variant="h6"
            component="h2"
            className="feature-card__title"
          >
            Qualité & Pipeline Wireit
          </Typography>
          <Typography variant="body2" className="feature-card__description">
            ESLint Flat Config, Prettier, Knip, TypeScript check et Sonar
            optimisés par le cache Wireit.
          </Typography>
        </CardContent>
      </Card>
    </section>
  </main>
</Layout>
