---
import { useTranslations } from '../i18n';
import { PdfDownloadFab } from '../components/PdfDownloadFab.tsx';
import '../styles/documents.css';

interface Props {
  title?: string;
  description?: string;
  theme?: string;
  pdfTheme?: string;
  pdf?: boolean;
  pdfUrl?: string;
  pdfLabel?: string;
  downloadFileName?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    theme?: string;
    pdfTheme?: string;
    pdf?: boolean;
    pdfUrl?: string;
    pdfLabel?: string;
    downloadFileName?: string;
  };
}

const t = useTranslations();
const frontmatter = Astro.props.frontmatter || {};
const title = Astro.props.title || frontmatter.title || t.documents.a4DefaultTitle;
const description =
  Astro.props.description || frontmatter.description || t.documents.a4DefaultDescription;
const theme = Astro.props.theme || frontmatter.theme || 'dark';
const pdfTheme = Astro.props.pdfTheme || frontmatter.pdfTheme || 'light';
const pdf = Astro.props.pdf ?? frontmatter.pdf ?? true;
const pdfUrl = Astro.props.pdfUrl || frontmatter.pdfUrl;
const pdfLabel = Astro.props.pdfLabel || frontmatter.pdfLabel || t.documents.pdfDownloadLabel;
const downloadFileName = Astro.props.downloadFileName || frontmatter.downloadFileName;

// Auto-derive PDF url if not explicitly passed
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const autoPdfUrl = pdfUrl || `/pdf${currentPath}.pdf`;
const autoFileName = downloadFileName || `${currentPath.split('/').pop() || 'document'}.pdf`;
---

<!doctype html>
<html lang="fr" data-theme={theme} data-pdf-theme={pdfTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Google Fonts: Inter, Recursive & JetBrains Mono for Design System Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:wght@400;500;600&family=Recursive:slnt,wght,CASL,CRSV,MONO@-15..0,300..1000,0..1,0..1,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main class="a4-document-canvas">
      <slot />
    </main>

    {pdf && (
      <PdfDownloadFab
        client:load
        pdfUrl={autoPdfUrl}
        downloadFileName={autoFileName}
        label={pdfLabel}
      />
    )}
  </body>
</html>
