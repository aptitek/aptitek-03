{
  "name": "",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "storybook": "storybook dev -p 6006",
    "build": "wireit",
    "build:astro": "wireit",
    "build:pdf": "wireit",
    "build:storybook": "wireit",
    "lint": "wireit",
    "lint:eslint": "wireit",
    "lint:prettier": "wireit",
    "lint:knip": "wireit",
    "lint:typecheck": "wireit",
    "lint:markdown": "wireit",
    "lint:sonar": "wireit",
    "lint:fix": "wireit",
    "test": "wireit",
    "test:unit": "wireit",
    "test:stories": "wireit",
    "test:coverage": "wireit",
    "test:e2e": "wireit",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "clean": "wireit",
    "prepare": "husky"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:astro",
        "build:pdf",
        "build:storybook"
      ]
    },
    "build:pdf": {
      "command": "node --experimental-strip-types scripts/generate-pdf.ts",
      "dependencies": [
        "build:astro"
      ],
      "files": [
        "scripts/generate-pdf.ts",
        "src/**/*",
        "astro.config.mjs",
        "package.json"
      ],
      "output": [
        "dist/pdf/**"
      ]
    },
    "build:astro": {
      "command": "astro build",
      "files": [
        "src/**/*",
        "public/**/*",
        "astro.config.mjs",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "dist/**"
      ]
    },
    "build:storybook": {
      "command": "storybook build",
      "files": [
        "src/**/*",
        ".storybook/**/*",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "storybook-static/**"
      ]
    },
    "lint": {
      "dependencies": [
        "lint:eslint",
        "lint:prettier",
        "lint:markdown",
        "lint:knip",
        "lint:typecheck",
        "lint:sonar"
      ]
    },
    "lint:eslint": {
      "command": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
      "files": [
        "src/**/*",
        "tests/**/*",
        ".storybook/**/*",
        "eslint.config.mjs",
        "tsconfig.json",
        "package.json"
      ]
    },
    "lint:prettier": {
      "command": "prettier --check --cache .",
      "files": [
        "src/**/*",
        "tests/**/*",
        ".storybook/**/*",
        "*.{mjs,js,ts,json,md,yml,yaml}",
        ".prettierrc.mjs",
        ".prettierignore"
      ]
    },
    "lint:knip": {
      "command": "knip --cache --cache-location node_modules/.cache/knip/",
      "files": [
        "src/**/*",
        "tests/**/*",
        ".storybook/**/*",
        "knip.json",
        "package.json",
        "tsconfig.json"
      ]
    },
    "lint:typecheck": {
      "command": "astro check --tsconfig ./tsconfig.app.json",
      "files": [
        "src/**/*",
        "astro.config.mjs",
        "tsconfig.json",
        "tsconfig.app.json",
        "package.json"
      ]
    },
    "lint:markdown": {
      "command": "markdownlint-cli2",
      "files": [
        "**/*.md",
        ".markdownlint-cli2.yaml"
      ]
    },
    "lint:sonar": {
      "command": "node -e \"if (process.env.SONAR_TOKEN || process.env.SONAR_HOST_URL) { require('child_process').spawnSync('sonar-scanner-npm', { stdio: 'inherit', shell: true }); } else { console.log('ℹ️ Sonar scan skipped: SONAR_TOKEN / SONAR_HOST_URL not defined'); }\"",
      "files": [
        "src/**/*",
        "tests/**/*",
        "sonar-project.properties"
      ]
    },
    "lint:fix": {
      "command": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ && markdownlint-cli2 --fix && knip --fix && prettier --write --cache --cache-location node_modules/.cache/prettier/ ."
    },
    "test": {
      "dependencies": [
        "test:unit",
        "test:coverage",
        "test:stories",
        "test:e2e"
      ]
    },
    "test:unit": {
      "command": "vitest run --project=unit",
      "files": [
        "src/**/*.{ts,tsx,js,jsx}",
        "tests/unit/**/*.{ts,tsx,js,jsx}",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project=unit",
      "files": [
        "src/**/*.{ts,tsx,js,jsx}",
        "tests/unit/**/*.{ts,tsx,js,jsx}",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ],
      "output": [
        "coverage/**"
      ]
    },
    "test:stories": {
      "command": "vitest run --project=storybook",
      "files": [
        "src/**/*.{ts,tsx,js,jsx,css}",
        ".storybook/**/*",
        "vitest.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test:e2e": {
      "command": "playwright test",
      "dependencies": [
        "build:astro",
        "test:stories"
      ],
      "files": [
        "tests/e2e/**/*.{ts,js}",
        "playwright.config.ts",
        "package.json"
      ]
    },
    "clean": {
      "command": "rm -rf dist storybook-static coverage test-results playwright-report .wireit .astro node_modules/.cache"
    }
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.2",
    "material-shapes-ts": "^0.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-material-expressive": "^1.1.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@chromatic-com/storybook": "latest",
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sonar/scan": "^5.0.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/node": "^26.5.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/browser-playwright": "5.0.0",
    "@vitest/coverage-v8": "5.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.1.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "markdownlint-cli2": "^0.23.2",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "remark-directive": "^4.0.0",
    "storybook": "^10.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.0",
    "wireit": "^0.14.13"
  }
}
